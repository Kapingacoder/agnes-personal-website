# Raise upload limits for admin media uploads when PHP runs as an Apache
# module. Each directive is wrapped in an <IfModule> guard so this file is
# a no-op (never causes a 500 error) on servers where mod_php isn't loaded,
# e.g. when PHP runs via PHP-FPM or the built-in CLI server instead.
<IfModule mod_php.c>
    php_value upload_max_filesize 150M
    php_value post_max_size 160M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 150M
    php_value post_max_size 160M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 150M
    php_value post_max_size 160M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>
